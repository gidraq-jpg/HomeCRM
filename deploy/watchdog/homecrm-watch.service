[Unit]
Description=HomeCRM watchdog: one check of /health
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/homecrm-watch.sh
# Сторожу нужны только сеть и свои папки.
DynamicUser=yes
StateDirectory=homecrm-watch
LogsDirectory=homecrm-watch
Environment=STATE_DIR=/var/lib/homecrm-watch
Environment=LOG_FILE=/var/log/homecrm-watch/watch.log
EnvironmentFile=-/etc/homecrm-watch.env
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
