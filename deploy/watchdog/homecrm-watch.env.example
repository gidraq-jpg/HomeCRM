# Пример /etc/homecrm-watch.env на VPS (chmod 600, владелец root). Настоящие значения в репозиторий не попадают.
WATCH_URL=https://home.gidraq.link:8443/health
FAIL_THRESHOLD=5
# Заготовка под Telegram (R2). Из России Telegram API почти недоступен: канал включают на зарубежном VPS.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
