# Предпросмотр: проверка выпуска до переключения рабочего окружения (R0.11, ADR-0021).
# Подключается так: docker compose -p homecrm-preview --env-file deploy/preview.env -f deploy/compose.yaml --profile app up -d --build
# Своё имя проекта (тома и база отдельные), свой порт 8301, свои секреты и без резервных копий:
# в предпросмотре данные одноразовые, а копии рабочей базы он не должен перемешивать.
# Здесь нет секретов: только имена и порты.
HOMECRM_APP_PORT=8301
HOMECRM_APP_SECRETS=E:/HomeCRM-data/secrets/preview
BACKUP_ENABLED=0
